# URL вашего auth-эндпоинта который проверяет токен и возвращает {id, name, avatar}
# Пример: https://functions.poehali.dev/<auth-me-id>
AUTH_VERIFY_URL=https://functions.poehali.dev/REPLACE_WITH_AUTH_ME_FUNCTION_ID

# Секрет для TURN (генерируется командой openssl rand -hex 32)
TURN_SECRET=REPLACE_WITH_TURN_SECRET

# Email для Let's Encrypt
LETSENCRYPT_EMAIL=admin@visov.ru
