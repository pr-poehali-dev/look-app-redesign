{
  "tests": [
    {
      "name": "Get messages",
      "method": "GET",
      "path": "/?module=chat&action=messages&chat_id=test_chat",
      "expectedStatus": 200,
      "expectedBody": {"messages": []},
      "bodyMatcher": "partial"
    },
    {
      "name": "Send message",
      "method": "POST",
      "path": "/?module=chat",
      "body": {"chat_id": "test_chat", "content": "Привет!", "type": "text"},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Get online users",
      "method": "GET",
      "path": "/?module=chat&action=online",
      "expectedStatus": 200,
      "expectedBody": {"users": [{"id": "anon"}]},
      "bodyMatcher": "partial"
    },
    {
      "name": "Get all registered users",
      "method": "GET",
      "path": "/?module=chat&action=all_users",
      "expectedStatus": 200,
      "expectedBody": {"users": []},
      "bodyMatcher": "partial"
    },
    {
      "name": "Send signal",
      "method": "POST",
      "path": "/?module=signal",
      "body": {"room_id": "room1", "to_user": "user2", "type": "offer", "payload": {"sdp": "test"}},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Get signals",
      "method": "GET",
      "path": "/?module=signal&room_id=room1",
      "expectedStatus": 200,
      "expectedBody": {"signals": []},
      "bodyMatcher": "partial"
    },
    {
      "name": "Send typing",
      "method": "POST",
      "path": "/?module=chat",
      "body": {"action": "typing", "chat_id": "test_chat"},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Get typing",
      "method": "GET",
      "path": "/?module=chat&action=typing_get&chat_id=test_chat",
      "expectedStatus": 200,
      "expectedBody": {"typing": []},
      "bodyMatcher": "partial"
    },
    {
      "name": "Get communities",
      "method": "GET",
      "path": "/?module=community&action=list",
      "expectedStatus": 200,
      "expectedBody": {"communities": []},
      "bodyMatcher": "partial"
    },
    {
      "name": "Join community",
      "method": "POST",
      "path": "/?module=community",
      "body": {"action": "join", "community_id": "com_photo_ru"},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Call start log",
      "method": "POST",
      "path": "/?module=calls",
      "body": {"action": "start", "callee_id": "user_x", "callee_name": "Test", "mode": "audio", "room_id": "r1"},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Call list",
      "method": "GET",
      "path": "/?module=calls",
      "expectedStatus": 200,
      "expectedBody": {"calls": []},
      "bodyMatcher": "partial"
    }
  ]
}