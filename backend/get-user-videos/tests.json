{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Register missing fields",
      "method": "POST",
      "path": "/",
      "body": {"action": "register"},
      "expectedStatus": 400,
      "expectedBody": {"error": "Заполни все поля"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Login wrong credentials",
      "method": "POST",
      "path": "/",
      "body": {"action": "login", "email": "no@no.no", "password": "wrong"},
      "expectedStatus": 401,
      "expectedBody": {"error": "Неверный email или пароль"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Get user videos empty",
      "method": "GET",
      "path": "/?user_id=nonexistent_user",
      "expectedStatus": 200,
      "expectedBody": {"videos": []},
      "bodyMatcher": "partial"
    },
    {
      "name": "Delete media missing id",
      "method": "POST",
      "path": "/",
      "body": {"token": "bad_token"},
      "expectedStatus": 400,
      "expectedBody": {"error": "id required"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Get public profile not found",
      "method": "POST",
      "path": "/",
      "body": {"action": "get_public_profile", "handle": "no_such_user_xyz_123"},
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "QR create session",
      "method": "POST",
      "path": "/",
      "body": {"action": "qr_create"},
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "QR status not found",
      "method": "POST",
      "path": "/",
      "body": {"action": "qr_status", "code": "nonexistent_code_xyz"},
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "QR approve bad token",
      "method": "POST",
      "path": "/",
      "body": {"action": "qr_approve", "code": "any", "token": "bad_token_xyz"},
      "expectedStatus": 401,
      "bodyMatcher": "partial"
    }
  ]
}