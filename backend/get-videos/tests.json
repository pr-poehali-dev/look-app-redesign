{
  "tests": [
    {
      "name": "GET videos",
      "method": "GET",
      "path": "/?type=video",
      "expectedStatus": 200
    },
    {
      "name": "GET personalized feed",
      "method": "GET",
      "path": "/?type=video&user_id=1",
      "expectedStatus": 200
    },
    {
      "name": "GET single video not found",
      "method": "GET",
      "path": "/?id=999999999",
      "expectedStatus": 404
    },
    {
      "name": "GET videos by category",
      "method": "GET",
      "path": "/?type=video&category=music",
      "expectedStatus": 200
    },
    {
      "name": "GET by brand",
      "method": "GET",
      "path": "/?brand=test",
      "expectedStatus": 200
    },
    {
      "name": "GET by series",
      "method": "GET",
      "path": "/?series=test&series_owner=u1",
      "expectedStatus": 200
    }
  ]
}