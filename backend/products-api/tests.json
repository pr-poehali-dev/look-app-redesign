{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET one без id -> 400",
      "method": "GET",
      "path": "/?action=one",
      "expectedStatus": 400
    },
    {
      "name": "GET one несуществующий -> 404",
      "method": "GET",
      "path": "/?action=one&id=999999999",
      "expectedStatus": 404
    },
    {
      "name": "GET click_stats без X-User-Id -> 401",
      "method": "GET",
      "path": "/?action=click_stats",
      "expectedStatus": 401
    },
    {
      "name": "GET by_video без video_ids -> 400",
      "method": "GET",
      "path": "/?action=by_video",
      "expectedStatus": 400
    },
    {
      "name": "GET by_video с несуществующим video_id",
      "method": "GET",
      "path": "/?action=by_video&video_ids=999999",
      "expectedStatus": 200,
      "expectedBody": {"products": {}},
      "bodyMatcher": "partial"
    },
    {
      "name": "GET partner_catalog",
      "method": "GET",
      "path": "/?action=partner_catalog",
      "expectedStatus": 200,
      "expectedBody": {"products": []},
      "bodyMatcher": "partial"
    },
    {
      "name": "GET mine без X-User-Id -> 401",
      "method": "GET",
      "path": "/?action=mine",
      "expectedStatus": 401
    },
    {
      "name": "GET shop без user_id -> 400",
      "method": "GET",
      "path": "/?action=shop",
      "expectedStatus": 400
    },
    {
      "name": "GET catalog",
      "method": "GET",
      "path": "/?action=catalog",
      "expectedStatus": 200
    }
  ]
}