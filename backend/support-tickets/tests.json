{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Validation fails on empty",
      "method": "POST",
      "path": "/",
      "body": {"action": "create", "subject": "", "message": ""},
      "expectedStatus": 400
    },
    {
      "name": "Create ticket",
      "method": "POST",
      "path": "/",
      "body": {"action": "create", "subject": "Тест", "message": "Проверка тикета", "user_email": "test@test.ru", "category": "bug"},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "List by category",
      "method": "POST",
      "path": "/",
      "body": {"action": "list", "category": "bug"},
      "expectedStatus": 200,
      "expectedBody": {"tickets": "array"},
      "bodyMatcher": "partial"
    },
    {
      "name": "List tickets",
      "method": "POST",
      "path": "/",
      "body": {"action": "list"},
      "expectedStatus": 200,
      "expectedBody": {"tickets": "array"},
      "bodyMatcher": "partial"
    }
  ]
}